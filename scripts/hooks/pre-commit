#!/usr/bin/env bash
# oss-atlas pre-commit hook — OFFLINE only (no network; safe and fast).
#   1. regenerate the health radar SVG cards from each staged page's `health:` block
#      (keeps the image == its SSOT — scoring itself lives in tools/health.py / skills),
#   1b. regenerate How-it-works flow cards + in-page step lists from flows/*.json,
#   2. regenerate the committed reverse-index reports when the tree shape changed
#      (keeps reports/ == the pages — the second CI structural-lint check),
#   3. run the linter and the reverse-index freshness check, and block the commit on any error.
# Install once with:  make install-hooks   (sets core.hooksPath to scripts/hooks)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 1. refresh cards for staged project pages that carry a health: block (offline)
# (no bashisms — works on macOS's stock bash 3.2; repo paths have no spaces)
staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^categories/.*\.md$' || true)
if [ -n "$staged" ]; then
  echo "$staged" | xargs python3 tools/health_card.py >/dev/null || true
  if ! git diff --quiet -- assets/health 2>/dev/null; then
    git add assets/health
    echo "pre-commit: refreshed health radar card(s) from frontmatter and staged them"
  fi
fi

# 1b. refresh How-it-works flow cards + generated step lists when a page or a flow spec is staged
#     (flows/<stem>.json is the SSOT; the SVGs and the in-page text list are derived)
flowish=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(categories/.*\.md|flows/.*\.json)$' || true)
if [ -n "$flowish" ]; then
  synced=$(python3 tools/flow_card.py --all | sed -n 's/^synced //p')
  if [ -n "$synced" ]; then
    echo "$synced" | xargs git add
    echo "pre-commit: re-synced flow step list(s) in: $(echo $synced | tr '\n' ' ')"
  fi
  if [ -n "$(git status --porcelain -- assets/flow 2>/dev/null)" ]; then
    git add assets/flow
    echo "pre-commit: refreshed flow card(s) from flows/ and staged them"
  fi
fi

# 2. refresh the committed reverse-index reports when page/tree shape is staged (offline)
# (reports are SSOT — tools/reverse_index.py --check fails when they drift from the pages)
engine=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(categories/|reports/|INDEX\.md$)' || true)
if [ -n "$engine" ]; then
  python3 tools/reverse_index.py --write >/dev/null
  if ! git diff --quiet -- reports 2>/dev/null; then
    git add reports
    echo "pre-commit: refreshed reverse-index reports from the pages and staged them"
  fi
fi

# 3. gates (the real guard): lint + committed-report freshness
python3 tools/lint.py
python3 tools/reverse_index.py --check
