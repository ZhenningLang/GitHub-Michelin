  "nodes": [
    {"id": "msg", "kind": "input", "en": "Message on Telegram, Discord, Matrix, email…", "zh": "Telegram、Discord、Matrix、邮件等渠道的消息"},
    {"id": "peers", "en": "Peer-group check; empty set means pairing code only", "zh": "对端组核对；集合为空则只认配对码", "technique": [1]},
    {"id": "agent", "en": "Agent loop bound to that channel", "zh": "绑定该渠道的 agent 循环"},
