    {"from": "gate", "to": "ask", "en": "medium risk", "zh": "中风险", "style": "dashed"},
    {"from": "ask", "to": "sandbox", "en": "approved", "zh": "获批", "style": "dashed"},
    {"from": "gate", "to": "sandbox", "en": "low risk or auto-approved", "zh": "低风险或自动批准"},
    {"from": "sandbox", "to": "receipt", "style": "dashed"},
    {"from": "receipt", "to": "agent", "en": "tool result for the next model call", "zh": "工具结果供下一次模型调用"},
    {"from": "model", "to": "reply", "en": "final answer", "zh": "最终回答"}
  ],
