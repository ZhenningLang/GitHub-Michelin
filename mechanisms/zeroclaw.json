    {"id": "gate", "en": "Risk profile: tool approval and shell risk rating", "zh": "风险档：工具审批与 shell 风险评级", "technique": [2]},
    {"id": "ask", "en": "Approve or deny in the originating chat", "zh": "在发起对话的聊天里批准或拒绝", "technique": [2]},
    {"id": "sandbox", "en": "OS sandbox if detected;\nelse runs as your user", "zh": "探测到系统沙箱就用；\n否则以你的用户身份运行", "technique": [3]},
    {"id": "receipt", "en": "Optional HMAC receipt on success", "zh": "成功时可选的 HMAC 回执", "technique": [4]},
    {"id": "reply", "kind": "output", "en": "Reply in the same chat", "zh": "在原聊天里回复"}
