{
  "schema": 1,
  "direction": "down",
  "nodes": [
    {"id": "video", "en": "Reference video file", "zh": "参考视频文件", "kind": "input"},
    {"id": "probe", "en": "Container scan: AIGC label, C2PA box, camera and transcode tags", "zh": "容器扫描：AIGC 标识、C2PA 盒、相机与转码标记", "technique": [2]},
    {"id": "measure", "en": "Shot split and per-shot measurements;\nframe cadence, noise, flat blocks, motion", "zh": "切镜与逐镜测量；\n帧率规律、噪声、平涂块、运动"},
    {"id": "look", "en": "Agent or VLM answers tiled sheets in up to 3 rounds", "zh": "agent 或 VLM 按轮次看拼图作答，最多 3 轮", "technique": [3]},
    {"id": "fuse", "en": "Trust-weighted fusion: group first, then subtype", "zh": "按可信度加权融合：先定大类，再定细类", "technique": [1]},
    {"id": "pkg", "en": "VIDEO.md package: card, map, timeline, per-shot files", "zh": "VIDEO.md 拆片包：卡片、地图、时间线、单镜文件", "kind": "output", "technique": [4]},
    {"id": "report", "en": "report.html for the human reader", "zh": "给人看的 report.html", "kind": "output"},
    {"id": "caps", "en": "Model capability map: seconds, shots, references per call", "zh": "模型能力地图：单次秒数、镜头数、参考数", "kind": "external", "technique": [5]},
    {"id": "plan", "en": "Pack shots into the fewest calls and check before paying", "zh": "把镜头装进最少调用，付费前先检查", "kind": "output", "technique": [5]}
  ],
  "edges": [
